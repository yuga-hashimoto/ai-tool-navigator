# Backup Docker Image
FROM postgres:15-alpine

# Install backup tools
RUN apk add --no-cache \
    postgresql-client \
    aws-cli \
    gnupg \
    coreutils \
    curl

# Create backup directory
RUN mkdir -p /backups/{scripts,config,logs,incremental} && \
    chmod 700 /backups

WORKDIR /backups

# Copy backup scripts
COPY scripts/ /backups/scripts/
COPY config/ /backups/config/

# Make scripts executable
RUN chmod +x /backups/scripts/*.sh

# Set environment
ENV PATH="/backups/scripts:$PATH"

# Healthcheck
HEALTHCHECK --interval=1h --timeout=30s --start-period=5m --retries=3 \
    CMD /backups/scripts/healthcheck.sh || exit 1

# Default command - wait for database and run backup
CMD ["/bin/sh", "-c", "sleep 10 && /backups/scripts/run_backup.sh"]
