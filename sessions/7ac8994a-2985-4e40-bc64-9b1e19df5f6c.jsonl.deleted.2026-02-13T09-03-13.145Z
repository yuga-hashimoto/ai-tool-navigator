 \"ImageObject\",\n      \"url\": `${SITE_URL}${article.image}`,\n      \"width\": \"1200\",\n      \"height\": \"630\"\n    };\n  }\n\n  if (article.tags && article.tags.length > 0) {\n    schema.keywords = article.tags.join(\", \");\n    schema.articleSection = article.tags[0];\n  }\n\n  return schema;\n}\n\n// =====================================================\n// FAQ SCHEMA\n// =====================================================","oldText":"  return schema;\n}\n\n// =====================================================\n// FAQ SCHEMA\n// ====================================================="}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M2.1","usage":{"input":30759,"output":513,"cacheRead":8454,"cacheWrite":0,"totalTokens":39726,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1770970107791}}
