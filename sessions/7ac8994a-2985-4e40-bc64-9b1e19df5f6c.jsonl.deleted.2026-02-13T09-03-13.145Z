n,\n  41         alternates: {\n  42             canonical: `/${locale}/category/${slug}`,\n  43         },\n  44         openGraph: {\n  45             title: fullTitle,\n  46             description: description,\n  47             type: 'website',\n  48             url: `/${locale}/category/${slug}`,\n  49         },\n  50         twitter: {\n  51             card: 'summary_large_image',\n  52             title: fullTitle,\n  53             description: description,\n  54         },\n  55     }\n  56 }\n  57 \n  58 export default async function CategoryPage({\n  59   params\n  60 }: {\n  61   params: Promise<{ locale: string; slug: string }>\n  62 }) {\n  63   const { locale, slug } = await params;\n  64   \n  65   // Validate slug\n  66   if (!Object.keys(CATEGORY_MAPPINGS).includes(slug)) {\n  67     notFound();\n  68   }\n  69 \n  70   const t = await getTranslations('CategoryPage');\n  71   const tBreadcrumbs = await getTranslations('Breadcrumbs');\n  72   \n  73   // Get the categories for the current slug\n  74   const targetCategories = CATEGORY_MAPPINGS[slug as keyof typeof CATEGORY_MAPPINGS];\n  75   \n  76   // Fetch all tools and filter\n  77   const tools = await getAllTools(locale);\n  78   const filteredTools = tools.filter((tool) => \n  79     targetCategories.includes(tool.category)\n  80   );\n  81 \n  82   // Get localized title and description\n  83   // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  84   const title = t(`${slug}_title` as any);\n  85   // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  86   const description = t(`${slug}_description` as any);\n  87 \n  88   const breadcrumbItems: BreadcrumbItem[] = [\n  89     { label: tBreadcrumbs('home'), href: '/' },\n  90     // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  91     { label: tBreadcrumbs(slug as any) },\n  92   ];\n  93 \n  94   const jsonLd = generateBreadcrumbSchema(breadcrumbItems, locale);\n+ 95   const collectionSchema = generateCollectionPageSchema({\n+ 96     name: title,\n+ 97     description: description,\n+ 98     url: `${process.env.NEXT_PUBLIC_SITE_URL}/${locale}/category/${slug}`,\n+ 99     itemCount: filteredTools.length\n+100   });\n  95 \n  96   return (\n  97     <div className=\"bg-white dark:bg-black min-h-screen transition-colors duration-300\">\n  98       <script\n  99         type=\"application/ld+json\"\n 100         dangerouslySetInnerHTML={{ __html: JSON.stringify(jsonLd) }}\n 101       />\n+108       <script\n+109         type=\"application/ld+json\"\n+110         dangerouslySetInnerHTML={{ __html: JSON.stringify(collectionSchema) }}\n+111       />\n 102       <div className=\"mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8\">\n 103         <Breadcrumbs items={breadcrumbItems} />\n 104         <div className=\"mx-auto max-w-2xl text-center mb-16\">\n 105           <h1 className=\"text-4xl font-extrabold tracking-tight text-zinc-900 sm:text-6xl dark:text-zinc-50\">\n     ...","firstChangedLine":8},"isError":false,"timestamp":1770970174924}}
