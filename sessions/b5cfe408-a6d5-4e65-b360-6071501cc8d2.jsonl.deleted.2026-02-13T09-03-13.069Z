{"type":"message","id":"50a74894","parentId":"d7d75c90","timestamp":"2026-02-13T08:03:27.193Z","message":{"role":"toolResult","toolCallId":"call_function_ehz6u6417k26_2","toolName":"read","content":[{"type":"text","text":"import createMiddleware from 'next-intl/middleware';\nimport {routing} from './i18n/routing';\n\nexport default createMiddleware(routing);\n\nexport const config = {\n  // Match all pathnames except for\n  // - … if they start with `/api`, `/_next` or `/_vercel`\n  // - … the ones containing a dot (e.g. `favicon.ico`)\n  // - … the blog route (which is not localized)\n  matcher: ['/((?!api|_next|_vercel|.*\\\\..*|blog).*)']\n};\n"}],"isError":false,"timestamp":1770969807187}}
